{
  "manifest_version": 3,
  "name": "Pin — bloqueador de anúncios para Pinterest",
  "short_name": "Pin",
  "version": "0.2.0",
  "description": "Esconde os Pins promovidos (anúncios) do Pinterest e sinaliza os pins que o Pinterest marca como feitos por IA. Não coleta dados.",
  "homepage_url": "https://github.com/RicardoBiazin/Pin",
  "permissions": ["storage"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Pin",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "content_scripts": [
    {
      "matches": ["*://*.pinterest.com/*", "*://*.pinterest.com.br/*", "*://pinterest.com/*"],
      "js": ["src/detector.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
